# ============================================================================
# SafeZone — environment variables (TEMPLATE, no real secrets)
# ----------------------------------------------------------------------------
# Copy this file to .env.local (local dev) or set the same names in your
# Vercel project settings (Production + Preview):
#     cp .env.example .env.local     # then fill in the real values
#
# The app degrades gracefully WITHOUT any of these (demo mode: seeded snapshot,
# in-memory writes) — but the live registry, report persistence and AI
# analysis all need them. Variable NAMES must match exactly, including the
# NEXT_PUBLIC_ prefix on the two client-side variables.
# ============================================================================

# --- REQUIRED for the live Supabase registry --------------------------------

# Your Supabase project URL, e.g. https://abcdefgh.supabase.co
# (Supabase dashboard → Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key — public read access (RLS-protected tables).
# (Supabase dashboard → Settings → API → Project API keys → anon/public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service_role (secret) key — SERVER-SIDE ONLY, never NEXT_PUBLIC_.
# All writes (reports, incidents, inspections, evidence-photo uploads) go
# through the service-role admin client because the app has no login screen.
# If this key is missing OR revoked, reports still file — but only into the
# in-memory overlay (temporary, lost on restart) and the server log says so.
# Rotate it in the Supabase dashboard if you ever see 401 "Unregistered API key".
SUPABASE_SERVICE_ROLE_KEY=

# --- REQUIRED for AI analysis (report classify + photo vision + cert OCR) ---

# Google AI Studio / Gemini API key — SERVER-SIDE ONLY, never NEXT_PUBLIC_.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- OPTIONAL -----------------------------------------------------------------

# Gemini model to use. Defaults to "gemini-3.6-flash" (the current
# general-purpose model; verified 2026-09). Only set this if Google
# retires/renames the model again.
# GEMINI_MODEL=

# --- OPTIONAL: AI provider selection ------------------------------------------
# Default (unset) = "gemini" — the production path for Vercel and any host.
# "zai" = use the z.ai SDK (GLM) — ONLY for platforms that provide that SDK's
# credentials (z.ai deployments). Never mix: a provider is selected
# explicitly and never silently switched on failure.
# AI_PROVIDER=gemini

# Vision model for the zai provider (rarely changed). Default glm-5v-turbo.
# GLM_VISION_MODEL=glm-5v-turbo

# NOTE — there is NO map API key. The map uses keyless ESRI ArcGIS Online
# Light Gray Canvas tiles (server.arcgisonline.com): no key, no watermark,
# nothing to configure. Do NOT add NEXT_PUBLIC_CARTO_KEY — it is retired and
# read nowhere; the old Carto basemap returned watermarked tiles.
